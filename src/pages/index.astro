---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getArtists, getScenes } from "../../backend/backend.mjs";
import ambianceImage from "../assets/flytapfest-ambiance.webp";
import heroShoeImage from "../assets/88435c53-9c31-4b60-81ef-e6b7426d731e.png";
import logoDoubs from "../assets/logo-doubs1.svg";
import partnerVille from "../assets/partner-ville.webp";
import logoTourisme from "../assets/logo-tourisme.svg";
import partnerRegion from "../assets/partner-region.webp";

const [artistsResult, scenesResult] = await Promise.all([getArtists(), getScenes()]);
const artists = artistsResult.items;
const scenes = scenesResult.items;
const heroArtists = artists.slice(0, 3);
const heroScenes = scenes.slice(0, 3);

function formatHeroDate(value) {
  if (!value) return "Horaire a venir";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  // On reconstruit l'heure en format francais: 20h00
  const parts = new Intl.DateTimeFormat("fr-FR", {
    timeZone: "Europe/Paris",
    day: "numeric",
    month: "long",
    hour: "2-digit",
    minute: "2-digit",
  }).formatToParts(date);

  const day = parts.find((part) => part.type === "day")?.value || "";
  const month = parts.find((part) => part.type === "month")?.value || "";
  const hour = parts.find((part) => part.type === "hour")?.value || "";
  const minute = parts.find((part) => part.type === "minute")?.value || "";

  return `${day} ${month}, ${hour}h${minute}`;
}
---

<Layout
  title="FlyTapFest | Accueil"
  description="Festival de claquettes et drones lumineux"
  currentPath={Astro.url.pathname}
>
  <section class="relative overflow-hidden bg-[radial-gradient(circle_at_16%_16%,rgba(30,88,249,0.36),transparent_26%),radial-gradient(circle_at_84%_12%,rgba(255,0,214,0.18),transparent_22%),linear-gradient(180deg,#020050_0%,#090b1c_52%,#05060d_100%)]">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute left-[-10%] top-[12%] hidden h-[420px] w-[420px] rounded-full bg-cyan-400/10 blur-3xl lg:block"></div>
      <div class="absolute right-[-10%] top-[4%] hidden h-[420px] w-[420px] rounded-full bg-fuchsia-500/10 blur-3xl lg:block"></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[#090b16] to-transparent"></div>
    </div>

    <div class="container-fly relative grid min-h-[680px] gap-10 pt-24 pb-14 md:min-h-[720px] lg:grid-cols-[minmax(0,1fr)_minmax(420px,0.95fr)] lg:items-center lg:gap-16 lg:pt-30 lg:pb-18">
      <div class="relative z-10 max-w-[680px]">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.22em] text-cyan-100/80 backdrop-blur">
          Edition 2026
          <span class="h-1.5 w-1.5 rounded-full bg-fuchsia-300"></span>
          Montbeliard
        </div>

        <h1 class="title-gradient font-display mt-8 max-w-[9ch] text-[2.9rem] leading-[1.02] tracking-[0.03em] sm:text-[3.8rem] lg:text-[4.7rem] xl:text-[5.1rem]">
          Entre claquettes et drones
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-200 md:text-lg">
          FlyTapFest melange tap dance, creation lumineuse et energie live pour transformer
          le Parc du Pres-la-Rose en spectacle grand format pendant deux soirees.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/infos#tarifs" class="btn-fly-primary">
            Consulter la billetterie
          </a>
          <a href="/programme" class="btn-fly-secondary">
            Voir le programme
          </a>
        </div>

        <div class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-3">
          <article class="rounded-2xl border border-white/12 bg-black/20 px-4 py-4 backdrop-blur">
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Dates</p>
            <p class="mt-2 text-xl font-semibold text-white">6-7 juin 2026</p>
          </article>
          <article class="rounded-2xl border border-white/12 bg-black/20 px-4 py-4 backdrop-blur">
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Lieu</p>
            <p class="mt-2 text-xl font-semibold text-white">Pres-la-Rose</p>
          </article>
          <article class="rounded-2xl border border-white/12 bg-black/20 px-4 py-4 backdrop-blur">
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Line-up</p>
            <p class="mt-2 text-xl font-semibold text-white">{artists.length} artistes</p>
          </article>
        </div>
      </div>

      <div class="relative z-10 flex items-center justify-center lg:justify-end">
        <div class="pointer-events-none absolute left-1/2 top-1/2 hidden h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-300/12 blur-3xl lg:block"></div>
        <div class="pointer-events-none absolute right-[8%] top-[18%] hidden h-[260px] w-[260px] rounded-full bg-fuchsia-500/12 blur-3xl lg:block"></div>
        <Image
          src={heroShoeImage}
          alt="Chaussure de claquettes FlyTapFest"
          class="relative z-10 w-full max-w-[360px] object-contain drop-shadow-[0_34px_55px_rgba(0,0,0,0.55)] sm:max-w-[460px] lg:max-w-[620px] xl:max-w-[680px]"
        />
      </div>
    </div>
  </section>

  <section class="bg-[#0a0a14] pb-8">
    <div class="container-fly grid gap-4 lg:grid-cols-[1.15fr_0.85fr_0.85fr]">
      <article class="card-fly p-5 md:p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-fuchsia-200/70">Line-up flash</p>
        {
          heroArtists.length ? (
            <ul class="mt-4 space-y-3">
              {heroArtists.map((artist) => (
                <li class="flex items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
                  <div>
                    <p class="font-semibold text-white">{artist.name}</p>
                    <p class="mt-1 text-xs uppercase tracking-[0.14em] text-slate-400">
                      {artist.sceneName || "Scene annoncee bientot"}
                    </p>
                  </div>
                  <span class="shrink-0 text-right text-xs font-semibold text-cyan-200">
                    {formatHeroDate(artist.date)}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm leading-7 text-slate-300">
              La programmation detaillee arrive bientot.
            </p>
          )
        }
      </article>

      <article class="card-fly p-5 md:p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-cyan-200/70">Scenes</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            heroScenes.length ? (
              heroScenes.map((scene) => (
                <a
                  href={`/scenes/${scene.slug || scene.id}`}
                  class="rounded-full border border-white/12 bg-white/5 px-3 py-2 text-sm font-semibold text-white transition hover:border-cyan-300/50 hover:text-cyan-200"
                >
                  {scene.name}
                </a>
              ))
            ) : (
              <span class="rounded-full border border-white/12 bg-white/5 px-3 py-2 text-sm text-slate-300">
                Scenes annoncees bientot
              </span>
            )
          }
        </div>
      </article>

      <article class="card-fly p-5 md:p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-violet-200/70">A voir</p>
        <div class="mt-4 grid gap-3">
          <a href="/programme" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:border-cyan-300/50 hover:text-cyan-200">
            Voir le programme complet
          </a>
          <a href="/festival" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:border-fuchsia-300/50 hover:text-fuchsia-200">
            Decouvrir le festival
          </a>
          <a href="/infos" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:border-violet-300/50 hover:text-violet-200">
            Consulter les infos pratiques
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="bg-[#0a0a14] py-12 md:py-16">
    <div class="container-fly space-y-14">
      <section class="grid gap-5 lg:grid-cols-[1.08fr_0.92fr]">
        <article class="card-fly relative overflow-hidden p-6 md:p-8 lg:p-10">
          <div class="absolute right-[-60px] top-[-60px] hidden h-44 w-44 rounded-full bg-cyan-400/10 blur-2xl lg:block"></div>
          <div class="absolute left-[-40px] bottom-[-70px] hidden h-48 w-48 rounded-full bg-fuchsia-500/10 blur-2xl lg:block"></div>

          <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Un festival entre ciel et terre</p>
          <h2 class="mt-4 max-w-[13ch] font-sans text-3xl font-semibold tracking-[-0.05em] text-white lg:text-5xl">
            Une experience scenique pensee pour le live.
          </h2>
          <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 lg:text-lg">
            Le FlyTapFest marie l'art des claquettes avec la precision graphique des drones lumineux pour creer
            une experience populaire, immersive et ancree dans le territoire de Montbeliard.
          </p>

          <div class="mt-8 grid gap-3 md:grid-cols-2">
            <article class="rounded-2xl border border-white/12 bg-black/20 p-4">
              <p class="text-xs uppercase tracking-[0.18em] text-cyan-200/70">Artistes confirmes</p>
              <p class="mt-3 text-4xl font-semibold text-white">{artists.length}</p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                Une programmation melangeant technique, rythme et experimentation.
              </p>
            </article>
            <article class="rounded-2xl border border-white/12 bg-black/20 p-4">
              <p class="text-xs uppercase tracking-[0.18em] text-fuchsia-200/70">Scenes actives</p>
              <p class="mt-3 text-4xl font-semibold text-white">{scenes.length}</p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                Des espaces de jeu ouverts au public du debut de soiree jusqu'au final lumineux.
              </p>
            </article>
          </div>

          <a href="/festival" class="btn-fly-secondary mt-8">
            Decouvrir le festival
          </a>
        </article>

        <aside class="grid gap-4">
          <article class="card-fly p-6 lg:p-7">
            <p class="text-xs uppercase tracking-[0.2em] text-violet-200/70">Atmosphere</p>
            <h3 class="mt-3 font-sans text-2xl font-semibold tracking-[-0.04em] text-white">
              Un site transforme en terrain de jeu scenique
            </h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              Entre village festival, zones de pause, points de vue sur les scenes et final aerien,
              l'accueil est pense pour faire circuler facilement le public entre les temps forts.
            </p>
          </article>

          <div class="grid gap-4 sm:grid-cols-2">
            <a href="/programme" class="card-fly block p-5 transition hover:-translate-y-1">
              <p class="text-xs uppercase tracking-[0.18em] text-cyan-200/70">Programme</p>
              <p class="mt-3 font-sans text-xl font-semibold text-white">Preparer sa soiree</p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                Horaires, genres, scenes et parcours de visite.
              </p>
            </a>

            <a href="/infos" class="card-fly block p-5 transition hover:-translate-y-1">
              <p class="text-xs uppercase tracking-[0.18em] text-fuchsia-200/70">Infos</p>
              <p class="mt-3 font-sans text-xl font-semibold text-white">Organiser sa venue</p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                Tarifs, acces, FAQ et services sur place.
              </p>
            </a>
          </div>
        </aside>
      </section>

      <section class="space-y-5">
        <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Temps forts</p>
            <h2 class="font-sans text-2xl font-semibold tracking-[-0.04em] text-white lg:text-4xl">Dates cles du festival</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-slate-300">
            Deux soirees de performances, d'ateliers et de rencontres avec un final aerien le samedi soir.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          <article class="card-fly space-y-3 p-5 lg:p-6">
            <p class="text-sm uppercase tracking-[0.18em] text-cyan-200/70">Vendredi 6 juin</p>
            <h3 class="font-sans text-2xl font-bold text-white">Ouverture du site</h3>
            <p class="text-sm leading-7 text-slate-300">Accueil du public, mise en route du village festival et premieres performances a partir de 18h00.</p>
          </article>
          <article class="card-fly space-y-3 p-5 lg:p-6">
            <p class="text-sm uppercase tracking-[0.18em] text-fuchsia-200/70">Samedi 7 juin</p>
            <h3 class="font-sans text-2xl font-bold text-white">Grande soiree</h3>
            <p class="text-sm leading-7 text-slate-300">Les scenes montent en puissance avec les spectacles principaux et les rencontres artistes-public.</p>
          </article>
          <article class="card-fly space-y-3 p-5 lg:p-6">
            <p class="text-sm uppercase tracking-[0.18em] text-violet-200/70">Samedi soir</p>
            <h3 class="font-sans text-2xl font-bold text-white">Final lumineux</h3>
            <p class="text-sm leading-7 text-slate-300">Cloture du festival avec un show collectif entre claquettes amplifiees et choregraphies de drones.</p>
          </article>
        </div>
      </section>

      <section class="space-y-5">
        <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Apercu</p>
            <h2 class="font-sans text-2xl font-semibold tracking-[-0.04em] text-white lg:text-4xl">Les sections principales</h2>
          </div>
          <p class="max-w-xl text-sm leading-7 text-slate-300">
            Retrouvez en un coup d'oeil le programme, les artistes invites et toutes les informations pratiques.
          </p>
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
          <a href="/programme" class="card-fly block space-y-4 p-6 transition hover:-translate-y-1 lg:min-h-[260px] lg:p-7">
            <p class="text-sm uppercase tracking-[0.18em] text-cyan-200/70">Programme</p>
            <h3 class="font-sans text-2xl font-bold text-white">Planning complet</h3>
            <p class="text-sm leading-7 text-slate-300">
              Consultez les passages par jour, filtrez par genre, horaire ou scene et telechargez le programme en PDF.
            </p>
          </a>

          <a href="/artists" class="card-fly block space-y-4 p-6 transition hover:-translate-y-1 lg:min-h-[260px] lg:p-7">
            <p class="text-sm uppercase tracking-[0.18em] text-fuchsia-200/70">Invites</p>
            <h3 class="font-sans text-2xl font-bold text-white">Artistes en vedette</h3>
            <p class="text-sm leading-7 text-slate-300">
              {artists.length} artistes deja annonces, avec fiches detaillees, galerie et horaires de representation.
            </p>
          </a>

          <a href="/infos" class="card-fly block space-y-4 p-6 transition hover:-translate-y-1 lg:min-h-[260px] lg:p-7">
            <p class="text-sm uppercase tracking-[0.18em] text-violet-200/70">Infos pratiques</p>
            <h3 class="font-sans text-2xl font-bold text-white">Venue, tarifs et acces</h3>
            <p class="text-sm leading-7 text-slate-300">
              Tarifs, hebergements, transports, FAQ et services sur site pour organiser votre venue sereinement.
            </p>
          </a>
        </div>
      </section>

      <section class="space-y-5">
        <Image src={ambianceImage} alt="Ambiance du festival" class="h-64 w-full rounded-lg object-cover" />
        <h2 class="font-sans text-2xl font-semibold tracking-[-0.04em] text-white lg:text-4xl">Nos partenaires</h2>
        <div class="grid grid-cols-2 gap-6 lg:grid-cols-4">
          <article class="space-y-2 text-center">
            <div class="flex h-[98px] items-center justify-center rounded-2xl border border-white/20 bg-gradient-to-br from-white/20 to-white/5 p-4">
              <Image src={logoDoubs} alt="Departement du Doubs" class="max-h-[72px] w-auto object-contain" />
            </div>
            <p class="text-sm font-bold leading-tight text-[#b0b0b0]">Departement du Doubs</p>
          </article>
          <article class="space-y-2 text-center">
            <div class="flex h-[98px] items-center justify-center rounded-2xl border border-white/20 bg-gradient-to-br from-white/20 to-white/5 p-4">
              <Image src={partnerVille} alt="Ville de Montbeliard" class="max-h-[72px] w-auto object-contain" />
            </div>
            <p class="text-sm font-bold leading-tight text-[#b0b0b0]">Ville de Montbeliard</p>
          </article>
          <article class="space-y-2 text-center">
            <div class="flex h-[98px] items-center justify-center rounded-2xl border border-white/20 bg-gradient-to-br from-white/20 to-white/5 p-4">
              <Image src={logoTourisme} alt="Office de Tourisme" class="max-h-[72px] w-auto object-contain" />
            </div>
            <p class="text-sm font-bold leading-tight text-[#b0b0b0]">Office de Tourisme</p>
          </article>
          <article class="space-y-2 text-center">
            <div class="flex h-[98px] items-center justify-center rounded-2xl border border-white/20 bg-gradient-to-br from-white/20 to-white/5 p-4">
              <Image src={partnerRegion} alt="Region Bourgogne-Franche-Comte" class="max-h-[72px] w-auto object-contain" />
            </div>
            <p class="text-sm font-bold leading-tight text-[#b0b0b0]">Region Bourgogne-Franche-Comte</p>
          </article>
        </div>
      </section>
    </div>
  </section>
</Layout>
