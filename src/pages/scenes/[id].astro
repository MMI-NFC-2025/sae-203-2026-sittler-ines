---
import Layout from "../../layouts/Layout.astro";
import ArtistCard from "../../components/ArtistCard.astro";
import Pbimage from "../../components/Pbimage.astro";
import {
  getArtistsByScene,
  getSceneByIdOrSlug,
} from "../../../backend/backend.mjs";

const { id } = Astro.params;
const scene = await getSceneByIdOrSlug(id);

if (!scene) {
  Astro.response.status = 404;
}

const sceneArtists = scene ? await getArtistsByScene(scene.id) : [];
---

<Layout
  title={scene ? `FlyTapFest | ${scene.name}` : "FlyTapFest | Scene introuvable"}
  description={scene?.description || "Details d'une scene du FlyTapFest"}
  currentPath="/scenes"
>
  {
    !scene ? (
      <section class="section-fly">
        <div class="container-fly card-fly p-8 text-center">
          <h1 class="text-3xl font-bold">Scene introuvable</h1>
          <p class="mt-3 text-slate-300">Cette scene est introuvable.</p>
          <a href="/scenes" class="btn-fly-primary mt-6">Retour aux scenes</a>
        </div>
      </section>
    ) : (
      <>
        <section class="section-fly">
          <div class="container-fly grid gap-8 lg:grid-cols-[1.25fr_1fr]">
            <div class="card-fly overflow-hidden">
              <Pbimage src={scene.image} alt={scene.name} class="h-full min-h-[360px] w-full object-cover" />
            </div>
            <div class="card-fly space-y-5 p-6">
              <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/80">Scene</p>
              <h1 class="title-gradient text-4xl font-bold md:text-5xl">{scene.name}</h1>
              {scene.description && <p class="leading-7 text-slate-300">{scene.description}</p>}
              <div class="flex flex-wrap gap-2">
                {scene.location && <span class="rounded-full border border-cyan-300/40 px-3 py-1 text-xs text-cyan-200">{scene.location}</span>}
                {scene.capacity && <span class="rounded-full border border-fuchsia-300/40 px-3 py-1 text-xs text-fuchsia-200">{scene.capacity} places</span>}
              </div>
            </div>
          </div>
        </section>

        <section class="section-fly bg-black/20">
          <div class="container-fly">
            <h2 class="mb-6 text-3xl font-bold">Infos pratiques</h2>
            <div class="space-y-3" data-accordion>
              <details class="card-fly p-4" open>
                <summary class="cursor-pointer text-lg font-semibold text-white">Acces</summary>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                  Des panneaux de signalisation guident les visiteurs depuis l'entree principale.
                </p>
              </details>
              <details class="card-fly p-4">
                <summary class="cursor-pointer text-lg font-semibold text-white">Horaires</summary>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                  Chaque scene fonctionne de 14h a 23h avec des performances en continu.
                </p>
              </details>
              <details class="card-fly p-4">
                <summary class="cursor-pointer text-lg font-semibold text-white">Services</summary>
                <p class="mt-3 text-sm leading-7 text-slate-300">
                  Restauration, points d'eau, toilettes et assistance PMR sont disponibles a proximite.
                </p>
              </details>
            </div>
          </div>
        </section>

        {sceneArtists.length > 0 && (
          <section class="section-fly bg-black/20">
            <div class="container-fly">
              <h2 class="mb-6 text-3xl font-bold">Artistes sur cette scene</h2>
              <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {sceneArtists.map((artist) => <ArtistCard artist={artist} />)}
              </div>
            </div>
          </section>
        )}
      </>
    )
  }

  <script>
    import { initAccordions } from "../../js/accordion.js";

    initAccordions();
  </script>
</Layout>



