---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SceneCard from "../components/SceneCard.astro";
import { getArtists, getScenes } from "../../backend/backend.mjs";
import ambianceImage from "../assets/flytapfest-ambiance.webp";

const [artistsResult, scenesResult] = await Promise.all([getArtists(), getScenes()]);
const artists = artistsResult.items;
const scenes = scenesResult.items;
---

<Layout
  title="FlyTapFest | Le Festival"
  description="Presentation du festival FlyTapFest"
  currentPath={Astro.url.pathname}
>
  <section class="section-fly">
    <div class="container-fly grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      <div class="card-fly space-y-5 p-6 md:p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Le Festival</p>
        <h1 class="title-gradient text-4xl font-bold md:text-5xl">Entre claquettes et drones</h1>
        <p class="text-sm leading-7 text-slate-300 md:text-base">
          FlyTapFest fait dialoguer les percussions du tap dance avec la puissance visuelle des drones lumineux.
          L'edition 2026 se deploie au Parc du Pres-la-Rose autour d'une meme promesse : faire vivre un spectacle total,
          accessible et ancre dans le territoire.
        </p>
        <div class="grid gap-3 sm:grid-cols-3">
          <article class="rounded-xl border border-white/15 bg-black/25 p-4">
            <p class="text-xs uppercase tracking-[0.15em] text-slate-400">Artistes</p>
            <p class="mt-1 text-2xl font-bold text-white">{artists.length}</p>
          </article>
          <article class="rounded-xl border border-white/15 bg-black/25 p-4">
            <p class="text-xs uppercase tracking-[0.15em] text-slate-400">Scenes</p>
            <p class="mt-1 text-2xl font-bold text-white">{scenes.length}</p>
          </article>
          <article class="rounded-xl border border-white/15 bg-black/25 p-4">
            <p class="text-xs uppercase tracking-[0.15em] text-slate-400">Dates</p>
            <p class="mt-1 text-2xl font-bold text-white">6-7 Juin</p>
          </article>
        </div>
      </div>

      <aside class="card-fly overflow-hidden">
        <Image
          src={ambianceImage}
          alt="Ambiance du festival"
          class="h-full min-h-[320px] w-full object-cover"
        />
      </aside>
    </div>
  </section>

  <section class="section-fly bg-black/20">
    <div class="container-fly grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <article class="card-fly space-y-5 p-6 md:p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Historique</p>
        <h2 class="text-3xl font-bold text-white">Une creation recente, une ambition forte</h2>
        <p class="text-sm leading-7 text-slate-300 md:text-base">
          Le festival est ne de la rencontre entre equipes artistiques locales, techniciens du spectacle et passionnes
          d'innovations visuelles. L'idee de depart etait simple : offrir un rendez-vous populaire capable de transformer
          un site public en scene hybride, a la fois musicale, choregraphique et technologique.
        </p>
        <p class="text-sm leading-7 text-slate-300 md:text-base">
          Depuis sa premiere edition, FlyTapFest cherche a faire cohabiter exigence artistique, accessibilite des formats
          et ouverture au grand public. Chaque edition renforce cette ligne en invitant des artistes capables d'inventer de
          nouveaux dialogues entre rythme, lumiere et espace.
        </p>
      </article>

      <article class="card-fly space-y-4 p-6 md:p-8">
        <p class="text-sm uppercase tracking-[0.2em] text-fuchsia-200/70">Objectifs</p>
        <h2 class="text-3xl font-bold text-white">Ce que porte l'edition 2026</h2>
        <ul class="space-y-3 text-sm leading-7 text-slate-300">
          <li>Mettre en avant des formes de scene innovantes sans perdre le lien avec la performance live.</li>
          <li>Valoriser le territoire de Montbeliard avec une programmation visible, ouverte et familiale.</li>
          <li>Donner de la place aux artistes, aux equipes techniques et au public dans une meme experience.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section-fly">
    <div class="container-fly space-y-6">
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/70">Equipe</p>
          <h2 class="text-3xl font-bold text-white">Les forces qui font tenir le festival</h2>
        </div>
        <p class="max-w-2xl text-sm leading-7 text-slate-300">
          Organisation, production et technique travaillent ensemble pour garantir un accueil fluide et des shows fiables,
          du premier montage jusqu'au final lumineux.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <article class="card-fly space-y-4 p-6">
          <h3 class="text-2xl font-bold text-white">Direction artistique</h3>
          <p class="text-sm leading-7 text-slate-300">
            Conception de la ligne editoriale, selection des artistes invites et articulation entre performance choregraphique
            et ecriture visuelle dans le ciel.
          </p>
        </article>
        <article class="card-fly space-y-4 p-6">
          <h3 class="text-2xl font-bold text-white">Production et accueil</h3>
          <p class="text-sm leading-7 text-slate-300">
            Coordination des plannings, accompagnement des artistes, gestion du public, billetterie et circulation entre les
            differentes zones du site.
          </p>
        </article>
        <article class="card-fly space-y-4 p-6">
          <h3 class="text-2xl font-bold text-white">Equipe technique</h3>
          <p class="text-sm leading-7 text-slate-300">
            Son, lumieres, securite aerienne, synchronisation des drones et supervision des scenes pour une experience stable
            et spectaculaire.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-fly bg-black/20">
    <div class="container-fly space-y-6">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-violet-200/70">Charte</p>
        <h2 class="text-3xl font-bold text-white">Les valeurs de l'edition</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <article class="card-fly space-y-3 p-6">
          <h3 class="text-2xl font-bold text-white">Innovation</h3>
          <p class="text-sm leading-7 text-slate-300">
            Chaque proposition doit croiser maitrise technique et impact scenique, sans effet gratuit ni demonstration creuse.
          </p>
        </article>
        <article class="card-fly space-y-3 p-6">
          <h3 class="text-2xl font-bold text-white">Accessibilite</h3>
          <p class="text-sm leading-7 text-slate-300">
            Le festival reste lisible pour tous les publics, avec une attention particuliere aux parcours, aux informations et
            a l'accueil sur site.
          </p>
        </article>
        <article class="card-fly space-y-3 p-6">
          <h3 class="text-2xl font-bold text-white">Responsabilite</h3>
          <p class="text-sm leading-7 text-slate-300">
            La programmation privilegie la sobriete des installations, la securite des dispositifs et une organisation respectueuse
            du lieu qui accueille l'evenement.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-fly bg-black/20">
    <div class="container-fly">
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="text-3xl font-bold">Scenes principales</h2>
        <a href="/scenes" class="btn-fly-secondary text-sm">Voir toutes les scenes</a>
      </div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {scenes.slice(0, 3).map((scene) => <SceneCard scene={scene} />)}
      </div>
    </div>
  </section>
</Layout>
