---
import Layout from "../../layouts/Layout.astro";
import Carousel from "../../components/Carousel.astro";
import Pbimage from "../../components/Pbimage.astro";
import { getArtistByIdOrSlug, getSceneByIdOrSlug } from "../../../backend/backend.mjs";

const { id } = Astro.params;
const artist = await getArtistByIdOrSlug(id);

if (!artist) {
  Astro.response.status = 404;
}

const scene = artist?.sceneId ? await getSceneByIdOrSlug(artist.sceneId) : null;
const artistMediaItems = (artist?.gallery || [artist?.image])
  .filter(Boolean)
  .map((src, index) => ({
    src,
    alt: `${artist?.name || "Artiste"} ${index + 1}`,
  }));
---

<Layout
  title={artist ? `FlyTapFest | ${artist.name}` : "FlyTapFest | Artiste introuvable"}
  description={artist?.bio || "Details d'un artiste du FlyTapFest"}
  currentPath="/artists"
>
  {
    !artist ? (
      <section class="section-fly">
        <div class="container-fly card-fly p-8 text-center">
          <h1 class="text-3xl font-bold">Artiste introuvable</h1>
          <p class="mt-3 text-slate-300">Cet artiste est introuvable.</p>
          <a href="/artists" class="btn-fly-primary mt-6">Retour aux artistes</a>
        </div>
      </section>
    ) : (
      <>
        <section class="section-fly">
          <div class="container-fly grid gap-8 lg:grid-cols-[1.3fr_1fr]">
            <div class="card-fly overflow-hidden">
              <Pbimage src={artist.image} alt={artist.name} class="h-full min-h-[360px] w-full object-cover" />
            </div>
            <div class="card-fly space-y-4 p-6">
              <p class="text-sm uppercase tracking-[0.2em] text-cyan-200/80">Artiste</p>
              <h1 class="title-gradient text-4xl font-bold md:text-5xl">{artist.name}</h1>
              {artist.specialty && <p class="text-lg text-cyan-100">{artist.specialty}</p>}
              {artist.bio && <p class="text-sm leading-7 text-slate-300">{artist.bio}</p>}
              <div class="flex flex-wrap gap-2 pt-2">
                {artist.genre && <span class="rounded-full border border-cyan-300/40 px-3 py-1 text-xs text-cyan-200">{artist.genre}</span>}
                {artist.country && <span class="rounded-full border border-fuchsia-300/40 px-3 py-1 text-xs text-fuchsia-200">{artist.country}</span>}
                {artist.date && <span class="rounded-full border border-violet-300/40 px-3 py-1 text-xs text-violet-200">{artist.date}</span>}
              </div>
              <div class="flex flex-wrap gap-3 pt-3">
                {scene && (
                  <a class="btn-fly-secondary text-sm" href={`/scenes/${scene.slug || scene.id}`}>
                    Voir la scene {scene.name}
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        <section class="section-fly bg-black/20">
          <div class="container-fly">
            <h2 class="mb-6 text-3xl font-bold">Photos de l'artiste</h2>
            <Carousel items={artistMediaItems} />
          </div>
        </section>
      </>
    )
  }
</Layout>



