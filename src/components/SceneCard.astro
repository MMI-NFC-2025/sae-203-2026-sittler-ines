---
import Pbimage from "./Pbimage.astro";
const { scene } = Astro.props;
---

<article class="card-fly overflow-hidden transition hover:-translate-y-1">
  <a href={`/scenes/${scene.slug || scene.id}`} class="grid h-full grid-rows-[220px_1fr]">
    <Pbimage
      src={scene.image}
      alt={scene.name}
      loading="lazy"
      class="h-full w-full object-cover"
    />
    <div class="space-y-3 p-5">
      <h3 class="text-xl font-bold text-white">{scene.name}</h3>
      {scene.description && (
        <p class="line-clamp-3 text-sm leading-6 text-slate-300">{scene.description}</p>
      )}
      <div class="flex flex-wrap gap-2">
        {scene.location && (
          <span class="rounded-full border border-cyan-300/40 px-2.5 py-1 text-xs text-cyan-200">
            {scene.location}
          </span>
        )}
        {scene.capacity && (
          <span class="rounded-full border border-fuchsia-300/40 px-2.5 py-1 text-xs text-fuchsia-200">
            {scene.capacity} places
          </span>
        )}
      </div>
    </div>
  </a>
</article>
